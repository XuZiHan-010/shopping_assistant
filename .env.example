APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=<postgresql-url>
TEST_DATABASE_URL=<postgresql-test-url>
FRONTEND_ORIGIN=http://localhost:5173
LLM_API_KEY=<deepseek-api-key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_ENABLED=false
BUSINESS_TIMEZONE=Asia/Shanghai
DEMO_MERCHANT_TOKENS=<json-token-to-merchant-id-map>
DEMO_MERCHANTS_ENDPOINT_ENABLED=true
# 仅对外演示部署时显式开启；生产环境不会仅凭上一项开放演示端点。
DEMO_DEPLOYMENT_MODE=false
# 非密钥但高风险的演示数据写权限；仅独立 Cron 使用，默认关闭且绝不暴露给前端。
ALLOW_DEMO_DATA_REFRESH=false
ADMIN_TOKEN=<development-placeholder>
EXPORT_URL_TTL_MINUTES=15
EXPORT_SIGNING_SECRET=<development-export-signing-secret>
# 以下两项当前不被 Settings 读取（config.py 无对应字段，extra="ignore" 会静默吞掉）。
# 真实取值是 app/intent/whitelist.py 与 app/agent/graph.py 里的常量，改这里没有效果。
MAX_QUERY_DAYS=180
MAX_DETAIL_ROWS=200
# 代码最多支持 3 轮；Railway 初期建议设置为 2，持续观察真实调用量后再调整。
QUALITY_MAX_ATTEMPTS=3
MAX_LLM_CALLS_PER_REQUEST=10
MAX_LLM_TOKENS_PER_REQUEST=25000
# 全局每日 token 预算（不分商家、不分访客，所有人共用一个池子，是唯一的总量闸门）。
# 500000 = 单请求上限 25000 × 20，最坏情况也保证 20 个完整问题；
# 按 2026-08-17 真实 deepseek-v4-flash 实测（每个完整问题约 6000 token）实际约 80 个。
LLM_DAILY_BUDGET_TOKENS=500000
# 推理模型专用下界：1024 时 reasoning 会吃光配额、正文返回空串，整条链路必然降级。
LLM_MAX_OUTPUT_TOKENS_PER_CALL=4096
LLM_TIMEOUT_SECONDS=90
RATE_LIMIT_PER_MINUTE=10
# 本地开发不得信任转发头：TRUSTED_PROXY_HOPS=0。
# Railway：TRUSTED_PROXY_HOPS=1 且 TRUSTED_PROXY_IPS 刻意留空；留空是已裁定策略，不是待填项。
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_IPS=
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_SECONDS=1
DB_STATEMENT_TIMEOUT_MS=5000
MAX_ATTACHMENTS=8
MAX_ATTACHMENT_MB=15
OCR_ENABLED=false
OCR_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=<optional>
OBJECT_STORAGE_BUCKET=<optional>
REDIS_URL=<optional>
