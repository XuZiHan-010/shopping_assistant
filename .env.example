APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=<postgresql-url>
TEST_DATABASE_URL=<postgresql-test-url>
FRONTEND_ORIGIN=http://localhost:5173
# 顾客端 shop 的精确 Origin（可选；未配置时 CORS 只放行商家端）
SHOP_ORIGIN=http://localhost:3000
LLM_API_KEY=<deepseek-api-key>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# converse()（v2 工具调用）走哪种 DeepSeek 协议：openai | anthropic，默认 openai。
# LLM_BASE_URL 始终是根地址；Anthropic 协议的 /anthropic 路径由适配器内部拼接。
LLM_PROTOCOL=openai
# converse() 的思考模式：enabled | disabled，默认 disabled，每次请求都显式发送。
LLM_THINKING=disabled
LLM_ENABLED=false
BUSINESS_TIMEZONE=Asia/Shanghai
DEMO_MERCHANT_TOKENS=<json-token-to-merchant-id-map>
# 会话有效期，范围 300–2592000 秒；默认 86400。
SESSION_TTL_SECONDS=86400
# 用于派生店铺内顾客脱敏别名；生产环境必须替换为稳定的高熵密钥。
BUYER_ALIAS_SECRET=<development-buyer-alias-secret>
# 仅服务端使用的 shop_slug 到演示 buyer_key 映射；不得由前端提交或在响应中返回。
DEMO_CUSTOMER_IDENTITIES=<json-shop-slug-to-buyer-key-map>
DEMO_MERCHANTS_ENDPOINT_ENABLED=true
# 仅对外演示部署时显式开启；生产环境不会仅凭上一项开放演示端点。
DEMO_DEPLOYMENT_MODE=false
# 非密钥但高风险的演示数据写权限；仅独立 Cron 使用，默认关闭且绝不暴露给前端。
ALLOW_DEMO_DATA_REFRESH=false
ADMIN_TOKEN=<development-placeholder>
# 只读镜像：与 ADMIN_TOKEN 认同一批 /api/admin/* 端点，但只放行 GET。
# 可以公开、可以打包进前端构建产物——与 ADMIN_TOKEN 不是同一等级的密钥。
# 留空则不启用只读浏览入口。配置时不可与 ADMIN_TOKEN 取值相同（启动时会拒绝）。
VIEWER_TOKEN=<optional-public-read-only-placeholder>
KNOWLEDGE_MAX_DOCUMENT_BYTES=262144
# N4-C 混合检索：本地嵌入模型（不是 LLM 调用，无费用）。留空 = 只用关键词，回答来源标注降级。
# 同名变量也是 backend 镜像的构建参数：构建期把模型下载进镜像。可选值见 docs/deployment.md。
EMBEDDING_MODEL=
# 留空取该模型的标定阈值；未标定的模型必须显式设置，否则启动失败。
EMBEDDING_MIN_SIMILARITY=
EMBEDDING_THREADS=1
# 完整每日简报的定时预生成；Cron 接线归 N5，真实首次生成需 R3 授权，默认关闭。
DAILY_BRIEF_SCHEDULE_ENABLED=false
EXPORT_URL_TTL_MINUTES=15
EXPORT_SIGNING_SECRET=<development-export-signing-secret>
# 以下两项当前不被 Settings 读取（config.py 无对应字段，extra="ignore" 会静默吞掉）。
# 真实取值是 app/intent/whitelist.py 与 app/agent/graph.py 里的常量，改这里没有效果。
MAX_QUERY_DAYS=180
MAX_DETAIL_ROWS=200
# 默认两轮；如提高到 3，必须同步提高 MAX_LLM_CALLS_PER_REQUEST（完整最坏路径会从 10 变为 12 次）。
QUALITY_MAX_ATTEMPTS=2
MAX_LLM_CALLS_PER_REQUEST=10
# 调用前检查按输入字节数保守估算（约为真实 token 的 3.5 倍），所以要按「已用 token + 下一次输入字节数」来配。
# 2026-10-07 实测：25000 时三步回合在第三次调用被拒；60000 时售后回合在第 5 次调用被拒。
MAX_LLM_TOKENS_PER_REQUEST=120000
# 三级每日 token 预算，按「每个商家每天能问 25 个左右」配出（2026-10-07 真实 deepseek-flash 实测：
# 商家回合约 8700 token，用到 Skill 的约 14600；调用前的保守预留让额度的最后约 28000 用不上）。
# 全局是总量闸门，所有人共用一个池子，一天最多花掉这么多；商家角色级 = 店铺级 × 3 个演示商家。
# 增减演示商家数量或目标问题数时，三项要一起改。
LLM_DAILY_BUDGET_TOKENS=1600000
LLM_CUSTOMER_DAILY_BUDGET_TOKENS=200000
LLM_MERCHANT_DAILY_BUDGET_TOKENS=1350000
LLM_SHOP_DAILY_BUDGET_TOKENS=450000
# 本地化批量翻译通道的独立单请求预算，与上面两项（主 Agent 流程）互不共享，
# 不是密钥。LOCALIZATION_MAX_BATCH_ITEMS/CHARS 限制单次批量调用能打包多少条
# 待译文本；超出上限的条目留给下一批调用，仍受 LOCALIZATION_MAX_CALLS_PER_REQUEST
# 约束。llm_usage.purpose=LOCALIZATION 区分这条通道自己的费用曲线。
LOCALIZATION_MAX_CALLS_PER_REQUEST=4
LOCALIZATION_MAX_TOKENS_PER_REQUEST=12000
LOCALIZATION_MAX_BATCH_ITEMS=20
LOCALIZATION_MAX_BATCH_CHARS=12000
MEMORY_EXTRACTION_MAX_CALLS=1
MEMORY_EXTRACTION_MAX_TOKENS=4000
# 推理模型专用：偏低时 reasoning 会吃光配额、正文返回空串，整条链路必然降级
# （2026-08-22 实测环比/同比这类问题在 4096 下即会触发），故取字段允许的上限 8000。
LLM_MAX_OUTPUT_TOKENS_PER_CALL=8000
LLM_TIMEOUT_SECONDS=90
# 零 LLM 前置闸门：问题与业务知识库/指标目录/商家历史记忆的加权匹配分低于阈值时
# 直接拒答，不占用任何 LLM 调用。停用后行为回到引入本能力之前（所有问题均放行）。
QUESTION_PREFILTER_ENABLED=true
# 默认 3 = 至少一个候选词命中某篇知识文档的标题。调低更容易放行，调高更容易拒绝。
QUESTION_PREFILTER_MIN_SCORE=3
RATE_LIMIT_PER_MINUTE=10
# 本地开发不得信任转发头：TRUSTED_PROXY_HOPS=0。
# Railway：TRUSTED_PROXY_HOPS=1 且 TRUSTED_PROXY_IPS 刻意留空；留空是已裁定策略，不是待填项。
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_IPS=
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_SECONDS=1
DB_STATEMENT_TIMEOUT_MS=5000
MAX_ATTACHMENTS=8
MAX_ATTACHMENT_MB=15
OCR_ENABLED=false
OCR_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=<optional>
OBJECT_STORAGE_BUCKET=<optional>
REDIS_URL=<optional>
