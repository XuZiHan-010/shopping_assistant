# 后端 API 基础地址。必须是含协议的绝对地址，不支持同源相对路径——
# 生产环境的静态服务器不代理 /api（见 AGENTS.md §十四）。
#
# 本文件只放占位符，真实值写进不纳入版本控制的 .env.local 或部署平台的环境变量。
VITE_API_BASE_URL=https://your-backend-host.example.com

# true 仅用于本地 Mock 演示与 E2E；false 时使用 VITE_API_BASE_URL 指向的真实后端。
VITE_USE_MOCK=true

# 可选：与后端 VIEWER_TOKEN 取值一致时，知识库/Chat BI 后台会出现"使用只读令牌
# 浏览"勾选项，方便访客免手输令牌直接查看（仅只读，无法增删改）。
# 允许打包进构建产物——这不是 ADMIN_TOKEN，公开不构成风险。留空则不显示该入口。
VITE_VIEWER_TOKEN=
