{
  "name": "@borough/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b && vue-tsc --noEmit -p tsconfig.vitest.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:first-paint": "playwright test --config playwright.first-paint.config.ts",
    "firstpaint:check": "node scripts/check-first-paint.mjs",
    "test:e2e:real": "playwright test --config playwright.real-api.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "codegen": "openapi-typescript ../docs/api.json -o src/api/generated.ts",
    "codegen:check": "node scripts/check-generated.mjs",
    "fixtures": "node scripts/sync-fixtures.mjs",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "mock:check": "node scripts/check-no-mock-payload.mjs",
    "secrets:check": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "happy-dom": "^20.0.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
